bash "$BASE/commands/verify.sh"
;;


realign)
bash "$BASE/commands/realign.sh"
;;


clean)
bash "$BASE/commands/clean.sh"
;;


backup)
bash "$BASE/commands/backup.sh"
;;


restore)
bash "$BASE/commands/restore.sh"
;;


report)
bash "$BASE/commands/report.sh"
;;


pipeline)
bash "$BASE/commands/pipeline.sh"
;;


docker)
bash "$BASE/commands/docker.sh"
;;


playwright)
bash "$BASE/commands/playwright.sh"
;;


api)
bash "$BASE/commands/api.sh"
;;


mobile)
bash "$BASE/commands/mobile.sh"
;;


performance)
bash "$BASE/commands/performance.sh"
;;


